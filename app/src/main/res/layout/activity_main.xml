<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ================================================================ -->
    <!-- SOLUM branded header                                              -->
    <!-- ================================================================ -->
    <LinearLayout
        android:id="@+id/mainHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/brand_primary"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="22dp"
        android:gravity="center_vertical">

        <!-- Bell icon — matches the installed app icon -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Employee Call" />

        <!-- Brand text column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="118dp"
                android:layout_height="28dp"
                android:adjustViewBounds="false"
                android:contentDescription="SOLUM"
                android:scaleType="centerCrop"
                android:src="@drawable/solum_wordmark_reversed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Employee Call"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Store Assistance Alerts"
                android:textSize="11sp"
                android:textColor="#CEB8E8" />

        </LinearLayout>

    </LinearLayout>

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_horizontal_padding"
            android:paddingTop="@dimen/screen_vertical_padding"
            android:paddingEnd="@dimen/screen_horizontal_padding"
            android:paddingBottom="28dp">

            <!-- ============================================================ -->
            <!-- LOGIN section                                                 -->
            <!-- ============================================================ -->
            <LinearLayout
                android:id="@+id/layoutLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Sign in to Employee Call"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Use your own AIMS username and password. Employee Call does not save your password."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Username / Email"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Enter username or email"
                    android:autofillHints="username"
                    android:inputType="textEmailAddress"
                    android:background="@drawable/card_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <!-- Password -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Password"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <!-- Password field with eye toggle -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Enter password"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:background="@drawable/card_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="52dp"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|center_vertical"
                        android:src="@drawable/ic_eye"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Toggle password visibility"
                        app:tint="@color/text_secondary" />

                </FrameLayout>

                <!-- Login error -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text=""
                    android:textColor="@color/error_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Login button with spinner overlay -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <Button
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Sign In"
                        android:textSize="15sp"
                        android:backgroundTint="@color/action_primary"
                        android:textColor="@color/white" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressLogin"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/white"
                        app:trackThickness="3dp"
                        app:indicatorSize="28dp" />

                </FrameLayout>

            </LinearLayout>

            <!-- ============================================================ -->
            <!-- READY section                                                 -->
            <!-- ============================================================ -->
            <LinearLayout
                android:id="@+id/layoutReady"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Status card with pulsing dot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <!-- Pulsing dot + status text -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Pulse container -->
                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="10dp">

                            <!-- Outer pulse ring (animated) -->
                            <View
                                android:id="@+id/viewPulseRing"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:background="@drawable/shape_circle_pulse"
                                android:alpha="0.6" />

                            <!-- Inner solid dot -->
                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:background="@drawable/shape_circle_green" />

                        </FrameLayout>

                        <!-- Right side: avatar circle + status text -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- User avatar: first letter of username in a circle -->
                            <TextView
                                android:id="@+id/tvUserAvatar"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/shape_avatar_circle"
                                android:gravity="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_marginEnd="12dp"
                                android:text="?" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ready for employee calls"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/green" />

                                <TextView
                                    android:id="@+id/tvReadyUser"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text=""
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tvCurrentStore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text=""
                                    android:textSize="12sp"
                                    android:textColor="@color/link_primary" />

                                <TextView
                                    android:id="@+id/tvActiveCountStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="No active calls"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Auth banner: shown when /auth/status reports the relay is signed out -->
                    <LinearLayout
                        android:id="@+id/layoutAuthBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/error_surface"
                        android:padding="14dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:id="@+id/tvAuthBannerTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sign in needed"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="@color/error_text" />

                            <TextView
                                android:id="@+id/tvAuthBannerMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sign in again to continue receiving new calls."
                                android:textSize="12sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <Button
                            android:id="@+id/btnAuthBannerSignIn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Sign In"
                            android:textSize="12sp"
                            android:backgroundTint="@color/error_action"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutDeliveryBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/warning_surface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDeliveryBannerMessage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnDeliverySettings"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Fix settings"
                            android:textSize="12sp"
                            android:backgroundTint="@color/action_primary"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <!-- Setup banner: shown when no field mapping has been saved for this store -->
                    <LinearLayout
                        android:id="@+id/layoutSetupBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@color/setup_surface"
                        android:padding="14dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Store setup needed"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Choose how this store's AIMS information should appear in employee calls."
                                android:textSize="12sp"
                                android:textColor="@color/text_primary"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <Button
                            android:id="@+id/btnSetupBannerConfigure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Set up"
                            android:textSize="12sp"
                            android:backgroundTint="@color/action_primary"
                            android:textColor="@color/white" />

                    </LinearLayout>

                    <!-- Last alert section (hidden until first alert) -->
                    <LinearLayout
                        android:id="@+id/layoutLastAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOST RECENT CALL"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:textAllCaps="true"
                            android:letterSpacing="0.10"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvLastAlertMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLastAlertTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Active Calls card (hidden when queue is empty) -->
                <LinearLayout
                    android:id="@+id/layoutActiveCalls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Red pulsing dot for active calls -->
                        <FrameLayout
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp">

                            <View
                                android:id="@+id/viewActiveCallsPulse"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:background="@drawable/shape_circle_pulse"
                                android:backgroundTint="@color/error_soft"
                                android:alpha="0.7" />

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:background="@drawable/shape_circle_green"
                                android:backgroundTint="@color/error_action" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvActiveCallsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active Calls"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/error_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Waiting for response"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnRespondNow"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="View and respond"
                        android:backgroundTint="@color/error_action"
                        android:textColor="@color/white" />

                </LinearLayout>

                <!-- Action buttons -->
                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="Call history"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <Button
                    android:id="@+id/btnTestAlert"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="10dp"
                    android:text="Preview alert"
                    android:backgroundTint="@color/action_primary"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:id="@+id/layoutStoreActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <Button
                        android:id="@+id/btnSwitchStore"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Switch Store"
                        style="@style/Widget.Material3.Button.OutlinedButton" />

                    <Button
                        android:id="@+id/btnAdmin"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Settings &amp; insights"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Sign Out"
                    style="@style/Widget.Material3.Button.TextButton" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
